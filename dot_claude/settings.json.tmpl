{
  "env": {
    "API_TIMEOUT_MS": "3000000",
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NEW_INIT": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_ENABLE_FINE_GRAINED_TOOL_STREAMING": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000"
  },
  "permissions": {
    "allow": [
      "Bash(cliproxyapi -codex-login)",
      "Bash(cliproxyapi:*)",
      "Bash(lsof:*)",
      "Bash(xargs kill -9)",
      "Bash(nix:*)",
      "Bash(nix-build:*)",
      "Bash(nix-shell:*)",
      "Bash(darwin-rebuild:*)",
      "Bash(home-manager:*)",
      "Bash(just:*)",
      "Bash(make:*)",
      "Bash(cargo:*)",
      "Bash(rustc:*)",
      "Bash(rustup:*)",
      "Bash(rustfmt:*)",
      "Bash(bun:*)",
      "Bash(bunx:*)",
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(tsx:*)",
      "Bash(tsc:*)",
      "Bash(deno:*)",
      "Bash(biome:*)",
      "Bash(prettier:*)",
      "Bash(eslint:*)",
      "Bash(vitest:*)",
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(python3:*)",
      "Bash(ruff:*)",
      "Bash(pytest:*)",
      "Bash(mypy:*)",
      "Bash(pyright:*)",
      "Bash(go:*)",
      "Bash(gofmt:*)",
      "Bash(swift:*)",
      "Bash(swiftc:*)",
      "Bash(xcrun:*)",
      "Bash(fd:*)",
      "Bash(eza:*)",
      "Bash(bat:*)",
      "Bash(rg:*)",
      "Bash(dust:*)",
      "Bash(procs:*)",
      "Bash(btm:*)",
      "Bash(delta:*)",
      "Bash(zoxide:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(mgrep:*)",
      "Bash(ast-grep:*)",
      "Bash(sg:*)",
      "Bash(codedb:*)",
      "Bash(rtk:*)",
      "Bash(gh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git stash list)",
      "mcp__fff__find_files",
      "mcp__fff__grep",
      "mcp__fff__multi_grep"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(~/.ssh/id_*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(~/.aws/credentials)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "enabledMcpjsonServers": [
    "qmd"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash {{ .chezmoi.homeDir }}/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "mgrep@Mixedbread-Grep": true,
    "code-simplifier@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "expert-lsp@elixir-expert": true,
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "git@frad-dotclaude": true,
    "gitflow@frad-dotclaude": true,
    "github@frad-dotclaude": true,
    "superpowers@frad-dotclaude": true,
    "refactor@frad-dotclaude": true,
    "code-context@frad-dotclaude": true
  },
  "extraKnownMarketplaces": {
    "frad-dotclaude": {
      "source": {
        "source": "github",
        "repo": "FradSer/dotclaude"
      },
      "autoUpdate": true
    }
  },
  "autoMemoryEnabled": true,
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "effortLevel": "xhigh",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
